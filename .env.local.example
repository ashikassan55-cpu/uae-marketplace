# Copy this file to .env.local and fill in real values.
# Get these from Firebase Console → Project settings → General → Your apps → SDK setup and configuration.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console → App Check → reCAPTCHA v3 → site key
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=

# Server-side only — used by Route Handlers / Server Actions that need
# elevated Firestore/Auth access. Firebase Console → Project settings →
# Service accounts → Generate new private key, then paste the ENTIRE JSON
# file content here as a single line (most hosts want it quoted).
FIREBASE_SERVICE_ACCOUNT_KEY=

# aistudio.google.com/apikey → Create API key. Free tier, no card required.
# Powers AI search ranking/reasoning for now (src/lib/ai/gemini-ranker.ts) —
# used server-side only (in /api/search/route.ts), never exposed to the
# browser. Leave blank and search silently falls back to plain keyword
# matching (see src/lib/search/keyword-rank.ts).
GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=

# console.anthropic.com → API keys. Not used yet — this is the swap-in for
# GEMINI_API_KEY once funded (see src/lib/ai/index.ts): moderation,
# translation, and verification document checks will use this once their
# Cloud Functions are deployed (needs the Blaze plan).
ANTHROPIC_API_KEY=
