rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isOwner(resourceOwnerUid) {
      return isSignedIn() && request.auth.uid == resourceOwnerUid;
    }
    // Fields a client is never allowed to set or change on create/update.
    // Backend (Cloud Functions with the Admin SDK, which bypasses these
    // rules entirely) is the only writer for these.
    function unchangedOrAbsent(field) {
      return !(field in request.resource.data) ||
        (field in resource.data && request.resource.data[field] == resource.data[field]);
    }

    // ---- config ----
    match /config/{doc} {
      allow read: if true;
      allow write: if false; // console/admin SDK only
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.role == 'individual'
        && !('suspended' in request.resource.data)
        && !('shopId' in request.resource.data);
      allow update: if isSelf(uid)
        && unchangedOrAbsent('role')
        && unchangedOrAbsent('shopId')
        && unchangedOrAbsent('suspended')
        && unchangedOrAbsent('suspendedReason')
        && unchangedOrAbsent('suspendedAt')
        && unchangedOrAbsent('rateLimit');
      allow delete: if false;
    }

    // ---- listings ----
    match /listings/{listingId} {
      allow read: if resource.data.status == 'active'
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && !('moderation' in request.resource.data)
        && !('embedding' in request.resource.data);
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && unchangedOrAbsent('moderation')
        && unchangedOrAbsent('embedding')
        && unchangedOrAbsent('ownerUid');
      allow delete: if isOwner(resource.data.ownerUid);
    }

    // ---- shops ----
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.verification.status == 'submitted'
        && !('proTrialEndsAt' in request.resource.data)
        && !('pro' in request.resource.data);
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid
        && unchangedOrAbsent('verification')
        && unchangedOrAbsent('proTrialEndsAt')
        && unchangedOrAbsent('pro')
        && unchangedOrAbsent('rating');
      allow delete: if false;

      match /stories/{storyId} {
        allow read: if true;
        allow write: if isSignedIn()
          && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
      }
    }

    // ---- carts (request-bundler, single shop per cart) ----
    match /carts/{cartId} {
      allow read, write: if isSignedIn() && cartId.matches(request.auth.uid + '_.*');
    }

    // ---- saves ----
    match /saves/{saveId} {
      allow read: if isSignedIn() &&
        (saveId.matches(request.auth.uid + '_.*') ||
         resource.data.shopId != null); // shops read their own saves via a query, not doc get
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && saveId == request.auth.uid + '_' + request.resource.data.listingId;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- chats ----
    match /chats/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantUids;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        allow update, delete: if false;
      }
    }

    // ---- offers: created only via a backend callable (rate-limit check
    // must be atomic with the write), never a raw client write ----
    match /offers/{offerId} {
      allow read: if isSignedIn() &&
        (resource.data.buyerUid == request.auth.uid || resource.data.shopId != null);
      allow write: if false;
    }

    // ---- transactions ----
    match /transactions/{transactionId} {
      allow read: if isSignedIn() &&
        (resource.data.sellerUid == request.auth.uid || resource.data.buyerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.sellerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.buyerUid == request.auth.uid
        && unchangedOrAbsent('sellerUid')
        && unchangedOrAbsent('listingId');
      allow delete: if false;
    }

    // ---- reviews ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.buyerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- reports ----
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false; // admin-only
    }

    // ---- appeals ----
    match /appeals/{appealId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false; // admin-only decision
    }

    // ---- backend-only collections: no client access at all ----
    match /analytics/{document=**} { allow read, write: if false; }
    match /searchCache/{document=**} { allow read, write: if false; }
    match /verificationLog/{document=**} { allow read, write: if false; }
    match /moderationLog/{document=**} { allow read, write: if false; }
  }
}
